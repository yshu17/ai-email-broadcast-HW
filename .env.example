# ---------------------------------------------------------------- database
# Local development with the bundled compose Postgres (docker compose up -d db). These are throwaway local
# credentials; anything shared or public needs a real password (see POSTGRES_PASSWORD below).
DATABASE_URL="postgres://mailer:mailer@localhost:5435/mailer"
# Managed Postgres (Neon/Supabase/RDS) generally needs TLS:
# DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
DATABASE_POOL_MAX=5

# ------------------------------------------------------------------ crypto
# 32-byte key protecting the SMTP password at rest. Generate with:
#   openssl rand -hex 32
# Changing this makes an already-stored SMTP password unreadable; you would
# simply re-enter it in Settings.
# The value below is a placeholder that is long enough to pass the check: replace it before you send anything.
ENCRYPTION_KEY="replace-me-with-openssl-rand-hex-32"

# ------------------------------------------------------------------- app
# Absolute public URL. Tracking pixels and unsubscribe links are built from it,
# so it MUST be the externally reachable address, not localhost, in production.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------ worker
# Shared secret for POST /api/worker/tick. Generate with: openssl rand -hex 32
WORKER_SECRET="replace-me-with-openssl-rand-hex-32"
# Stop claiming new work this many ms into an invocation, so the batch finishes
# before the platform's function timeout kills it.
WORKER_TIME_BUDGET_MS=45000
# Hard ceiling on recipients claimed per tick.
WORKER_BATCH_CAP=200
# Parallel SMTP sends within one batch.
WORKER_CONCURRENCY=4
# How often you actually invoke the worker. Used to spread the hourly quota
# evenly instead of firing it all in the first tick.
WORKER_TICK_INTERVAL_SECONDS=60
# Something has to call the worker endpoint on a timer, or scheduled campaigns never start and the queue
# never drains: Vercel Cron, an external cron, the compose `worker` service, or this switch. Set true only
# for a SINGLE container running the image without a worker service: the container then starts the ticker
# (dist-scripts/worker-loop.cjs) next to the web server and restarts it if it exits.
RUN_INTERNAL_WORKER=false
# Where the ticker writes a timestamp after every answered tick; the compose health check reads it.
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat
# A tick that has not answered after this long is abandoned and retried.
# WORKER_REQUEST_TIMEOUT_SECONDS=90
# Most scheduled campaigns started per tick (the rest go on the next tick, oldest first).
# SCHEDULER_BATCH_LIMIT=100
# A campaign that has sat in QUEUED with no recipient rows for this long is repaired.
# STUCK_CAMPAIGN_GRACE_SECONDS=300
# Where that ticker sends its requests. Defaults to the local server; APP_URL is
# deliberately not used, since it is the public URL for links in emails and may
# not resolve from inside the container.
# WORKER_TARGET_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------ Docker
# Read by compose.yaml only (not by the application).
#   docker compose up -d db                      just Postgres
#   docker compose --profile app up --build -d   migrate + web + worker
# Password of the compose Postgres. The default is for a laptop; set your own, URL-safe, for anything else.
# POSTGRES_PASSWORD=mailer
# Ports published on this machine.
# WEB_PORT=3000
# DB_PORT=5435
# The image name compose builds and runs.
# MAILER_IMAGE=mailer:local
# Migrations run as their own step (the compose `migrate` service). A single container can opt in to running
# them when it starts; never turn this on for several replicas at once.
# AUTO_MIGRATE=false

# ---------------------------------------------------------------- language
# The interface is Russian by default with an RU | EN switcher (remembered in a cookie).
# This one setting is different: the language of the text the app itself adds to emails
# (the unsubscribe footer, the plain-text line), and the fallback for the public
# unsubscribe page. It does not follow the admin's screen language.  ru | en
# EMAIL_LANGUAGE=ru

# ------------------------------------------------------ developer test panel
# A "Test Panel" drawer with a test clock, scheduler and rate-limit controls, test campaigns,
# an event journal and a built-in test SMTP server that only accepts made-up @test.invalid
# addresses. It exists ONLY when NODE_ENV is development or test AND this is exactly "true".
# Off by default. In production it is never available, whatever this says: the test API is not
# even built, and every test-only endpoint refuses on its own.
# While it is on, all mail goes to the built-in test SMTP server (the configured SMTP is not used).
ENABLE_EMAIL_TEST_PANEL=false
# Where the test SMTP server saves each message as an .eml file (ignored by Git). Default below.
# TEST_SMTP_OUTPUT_DIR=received-emails
# Port for the test SMTP server; 0 (default) lets the system pick a free one.
# TEST_SMTP_PORT=0

# --------------------------------------------------------------- sending
# The rate ceiling. SendPulse allows ~5000 SMTP emails/hour on the target plan.
SMTP_MAX_EMAILS_PER_HOUR=5000
# Aim for this fraction of the ceiling, so concurrent workers cannot overshoot.
SMTP_RATE_SAFETY_FACTOR=0.95
SMTP_MAX_ATTEMPTS=3
QUEUE_LEASE_SECONDS=300
MAX_IMPORT_ROWS=50000

# --------------------------------------------------------- SMTP (optional)
# SMTP is normally configured in the app's Settings page and stored encrypted.
# These variables override the database values, for deployments that prefer to
# keep credentials entirely out of the DB. Never commit real values.
#
# SendPulse:
#   SMTP_HOST=smtp-pulse.com
#   SMTP_PORT=587      (STARTTLS)  or 465 (implicit TLS)
#   SMTP_SECURITY=starttls | tls | none
#   SMTP_USER=<your SendPulse SMTP login>
#   SMTP_PASSWORD=<your SendPulse SMTP password>
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# SMTP_REPLY_TO=
# SMTP_MAX_CONNECTIONS=3
